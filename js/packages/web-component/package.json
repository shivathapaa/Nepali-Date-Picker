{
  "name": "@nepali-date-picker/web-component",
  "version": "3.1.1",
  "description": "Framework-agnostic <nepali-date-picker> custom element: a Bikram Sambat (Nepali) calendar date picker that works in React, Vue, Angular, Svelte, and plain HTML.",
  "type": "module",
  "license": "MPL-2.0",
  "author": "Shiva Thapa (@shivathapaa)",
  "homepage": "https://github.com/shivathapaa/Nepali-Date-Picker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivathapaa/Nepali-Date-Picker.git",
    "directory": "js/packages/web-component"
  },
  "bugs": {
    "url": "https://github.com/shivathapaa/Nepali-Date-Picker/issues"
  },
  "keywords": [
    "nepali",
    "date-picker",
    "datepicker",
    "bikram-sambat",
    "calendar",
    "web-component",
    "custom-element",
    "lit",
    "react",
    "vue",
    "angular",
    "svelte"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/nepali-date-picker.bundled.js",
    "./dist/nepali-date-picker.js",
    "./dist/nepali-date-range-picker.js",
    "./dist/nepali-date-picker-dialog.js",
    "./dist/nepali-date-picker-docked.js",
    "./dist/nepali-date-field.js",
    "./dist/nepali-date-range-field.js",
    "./dist/nepali-wheel-date-picker.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/nepali-date-picker.bundled.js",
  "jsdelivr": "./dist/nepali-date-picker.bundled.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bundle": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nepali-date-picker.bundled.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./nepali-date-picker": {
      "types": "./dist/nepali-date-picker.d.ts",
      "import": "./dist/nepali-date-picker.js"
    },
    "./nepali-date-range-picker": {
      "types": "./dist/nepali-date-range-picker.d.ts",
      "import": "./dist/nepali-date-range-picker.js"
    },
    "./nepali-date-picker-dialog": {
      "types": "./dist/nepali-date-picker-dialog.d.ts",
      "import": "./dist/nepali-date-picker-dialog.js"
    },
    "./nepali-date-picker-docked": {
      "types": "./dist/nepali-date-picker-docked.d.ts",
      "import": "./dist/nepali-date-picker-docked.js"
    },
    "./nepali-date-field": {
      "types": "./dist/nepali-date-field.d.ts",
      "import": "./dist/nepali-date-field.js"
    },
    "./nepali-date-range-field": {
      "types": "./dist/nepali-date-range-field.d.ts",
      "import": "./dist/nepali-date-range-field.js"
    },
    "./nepali-wheel-date-picker": {
      "types": "./dist/nepali-wheel-date-picker.d.ts",
      "import": "./dist/nepali-wheel-date-picker.js"
    }
  },
  "files": [
    "dist",
    "custom-elements.json",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "analyze": "cem analyze",
    "build": "npm run analyze && vite build && node scripts/build-bundle.mjs && tsc --emitDeclarationOnly --outDir dist && node scripts/gen-react-types.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:jsx": "tsc --noEmit --project type-tests/tsconfig.json",
    "check:manifest": "npm run analyze && git diff --exit-code custom-elements.json"
  },
  "dependencies": {
    "@nepali-date-picker/core": "^3.1.1",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@types/react": "^19.0.0",
    "esbuild": "^0.21.5",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "customElements": "custom-elements.json",
  "publishConfig": {
    "access": "public"
  }
}
